@model HR_system.Models.Department

@{
    ViewData["Title"] = "Add Department";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Back Button Link -->
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Departments
                </a>
            </div>

            <!-- Card Wrapper -->
            <div class="card border-0 shadow-sm rounded-3">

                <!-- Card Header -->
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px;">
                            <i class="bi bi-building-add fs-5"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-0">Add Department</h4>
                            <p class="text-muted small mb-0">Create a new department for your organization.</p>
                        </div>
                    </div>
                </div>

                <!-- Card Body Form -->
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" novalidate>

                        <!-- Model Summary Error Alert -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small mb-4" role="alert"></div>

                        <!-- Department Name (Floating Label) -->
                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" id="departmentName" placeholder="e.g. Human Resources" />
                            <label asp-for="Name" for="departmentName">Department Name <span class="text-danger">*</span></label>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Description (Floating Label) -->
                        <div class="form-floating mb-4">
                            <textarea asp-for="Description" class="form-control" id="departmentDescription" placeholder="Description" style="height: 120px;"></textarea>
                            <label asp-for="Description" for="departmentDescription">Department Description</label>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-2">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-2 shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Save Department
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}