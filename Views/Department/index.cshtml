@model IEnumerable<HR_system.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Departments</h2>
            <p class="text-muted small mb-0">Manage your organization's department structure and details.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm px-4">
            <i class="bi bi-plus-lg me-1"></i> Add Department
        </a>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-uppercase text-secondary fs-7">
                            <tr>
                                <th class="ps-4 py-3">Department Name</th>
                                <th class="py-3">Description</th>
                                <th class="py-3">Created Date</th>
                                <th class="text-end pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Name with Icon -->
                                    <td class="ps-4 fw-semibold text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px;">
                                                <i class="bi bi-building"></i>
                                            </div>
                                            <span>@item.Name</span>
                                        </div>
                                    </td>

                                    <!-- Description -->
                                    <td class="text-muted text-truncate" style="max-width: 300px;">
                                        @(string.IsNullOrEmpty(item.Description) ? "No description provided." : item.Description)
                                    </td>

                                    <!-- Formatted Date -->
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1 font-monospace fw-normal">
                                            <i class="bi bi-calendar3 me-1 text-muted"></i>
                                            @item.CreatedDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1 rounded-2" title="Edit">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-2" title="Delete">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- Empty State View -->
                <div class="text-center py-5">
                    <div class="display-6 text-muted mb-3">
                        <i class="bi bi-folder-x"></i>
                    </div>
                    <h5 class="fw-bold text-secondary">No Departments Found</h5>
                    <p class="text-muted mb-3">Get started by creating your first department.</p>
                    <a asp-action="Create" class="btn btn-sm btn-primary">
                        + Create Department
                    </a>
                </div>
            }
        </div>
    </div>
</div>