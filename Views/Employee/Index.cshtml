@model IEnumerable<HR_system.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="directory-container">

    <!-- Header & Action Bar -->
    <div class="directory-header-card mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h3 class="directory-title mb-1"><i class="bi bi-people me-2 text-primary"></i>Employee Directory</h3>
                <p class="directory-subtitle mb-0">Manage workforce accounts, role assignments, and organizational metadata.</p>
            </div>

            <a asp-action="Create" class="btn btn-primary btn-add-member">
                <i class="bi bi-plus-lg me-1.5"></i>Add Employee
            </a>
        </div>

        <!-- Search Toolbar -->
        <form method="get" asp-action="Index" class="directory-search-form mt-4">
            <div class="search-input-wrapper">
                <i class="bi bi-search search-lead-icon"></i>
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                       placeholder="Search by employee name" autocomplete="off" />
                <button type="submit" class="btn-search-submit">Search</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="directory-empty-card text-center py-5">
            <i class="bi bi-person-x fs-2 text-muted opacity-50 d-block mb-2"></i>
            <h6 class="fw-semibold text-dark mb-1">No employee records match your search</h6>
            <p class="text-muted small mb-0">Try clearing active filters or register a new employee record.</p>
        </div>
    }
    else
    {
        <!-- Professional Grid Layout -->
        <div class="directory-grid">
            @foreach (var emp in Model)
            {
                <div class="employee-card">

                    <!-- Clean Single-Dot Status Pill -->
                    <div class="card-status-bar">
                        <span class="status-pill @(emp.Status == "Active" ? "pill-active" : "pill-inactive")">
                            @emp.Status
                        </span>
                    </div>

                    <!-- Clean Avatar Frame -->
                    <div class="card-avatar-container">
                        @if (!string.IsNullOrEmpty(emp.EmployeePhoto))
                        {
                            <img src="@emp.EmployeePhoto" alt="@emp.FirstName @emp.LastName" class="avatar-image" />
                        }
                        else
                        {
                            <div class="avatar-fallback">
                                @(!string.IsNullOrWhiteSpace(emp.FirstName) ? emp.FirstName.Substring(0, 1).ToUpper() : "E")
                            </div>
                        }
                    </div>

                    <!-- Core Info -->
                    <div class="card-main-info text-center mt-3">
                        <h6 class="employee-name mb-1">@emp.FirstName @emp.LastName</h6>
                        <span class="employee-role-tag">
                            <i class="bi bi-shield-lock me-1"></i>@(emp.Role?.Name ?? "Employee")
                        </span>
                    </div>

                    <!-- Corporate Details List -->
                    <div class="card-details-box my-3">
                        <div class="detail-item">
                            <i class="bi bi-building"></i>
                            <span class="text-truncate">@(emp.Department?.Name ?? "Unassigned")</span>
                        </div>
                        <div class="detail-item">
                            <i class="bi bi-envelope"></i>
                            <span class="text-truncate">@emp.Email</span>
                        </div>
                        <div class="detail-item">
                            <i class="bi bi-telephone"></i>
                            <span>@emp.Phone</span>
                        </div>
                    </div>

                    <!-- Action Controls -->
                    <div class="card-footer-actions">
                        <a asp-action="Edit" asp-route-id="@emp.id" class="btn-card-action action-edit">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@emp.id" class="btn-card-action action-delete">
                            <i class="bi bi-trash3 me-1"></i>Delete
                        </a>
                    </div>

                </div>
            }
        </div>

        <!-- Corporate Pagination -->
        @if ((int)ViewBag.TotalPages > 1)
        {
            <div class="directory-pagination-wrapper mt-4">
                <nav class="pagination-nav">
                    @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                    {
                        if (i == (int)ViewBag.CurrentPage)
                        {
                            <span class="nav-page-item active">@i</span>
                        }
                        else
                        {
                            <a asp-action="Index"
                               asp-route-pageNumber="@i"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               class="nav-page-item">@i</a>
                        }
                    }
                </nav>
            </div>
        }
    }

</div>

<style>
    /* ===== Root Architecture & Entrance ===== */
    .directory-container {
        animation: pageFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* ===== Top Header Card ===== */
    .directory-header-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 24px;
        border: 1px solid #e2e8f0;
    }

    .directory-title {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .directory-subtitle {
        font-size: 13px;
        color: #64748b;
    }

    .btn-add-member {
        border-radius: 8px;
        font-size: 13.5px;
        font-weight: 600;
        padding: 9px 18px;
        background-color: #2563eb;
        border: 1px solid #1d4ed8;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        transition: all 0.2s ease;
    }

        .btn-add-member:hover {
            background-color: #1d4ed8;
            border-color: #1e40af;
        }

    /* ===== Search Input ===== */
    .directory-search-form {
        max-width: 580px;
    }

    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-lead-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 15px;
    }

    .search-input-wrapper input {
        width: 100%;
        padding: 10px 105px 10px 40px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        font-size: 13.5px;
        color: #1e293b;
        background-color: #f8fafc;
        outline: none;
        transition: all 0.2s ease;
    }

        .search-input-wrapper input:focus {
            border-color: #2563eb;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

    .btn-search-submit {
        position: absolute;
        right: 5px;
        background-color: #0f172a;
        color: #ffffff;
        border: none;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

        .btn-search-submit:hover {
            background-color: #1e293b;
        }

    /* ===== Grid System ===== */
    .directory-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 18px;
    }

    .employee-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .employee-card:hover {
            border-color: #cbd5e1;
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.06);
        }

    /* ===== Status Pill (No Extra Dots) ===== */
    .card-status-bar {
        position: absolute;
        top: 14px;
        right: 14px;
    }

    .status-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: capitalize;
    }

    .pill-active {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .pill-inactive {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* ===== Avatar Setup ===== */
    .card-avatar-container {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        margin-top: 8px;
        padding: 2px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
    }

    .avatar-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .avatar-fallback {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background-color: #f1f5f9;
        color: #334155;
        font-size: 26px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ===== Info & Tags ===== */
    .employee-name {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
    }

    .employee-role-tag {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        font-size: 11.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 6px;
    }

    /* ===== Corporate Details List ===== */
    .card-details-box {
        width: 100%;
        background: #f8fafc;
        border-radius: 8px;
        padding: 10px 12px;
        border: 1px solid #f1f5f9;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: #475569;
    }

        .detail-item i {
            font-size: 13px;
            color: #64748b;
            width: 14px;
        }

    /* ===== Card Actions ===== */
    .card-footer-actions {
        width: 100%;
        display: flex;
        gap: 8px;
        margin-top: auto;
    }

    .btn-card-action {
        flex: 1;
        text-align: center;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .action-edit {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

        .action-edit:hover {
            background: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

    .action-delete {
        background: #ffffff;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

        .action-delete:hover {
            background: #fef2f2;
            color: #991b1b;
            border-color: #fca5a5;
        }

    /* ===== Pagination Controls ===== */
    .directory-pagination-wrapper {
        display: flex;
        justify-content: center;
    }

    .pagination-nav {
        display: inline-flex;
        gap: 4px;
        background: #ffffff;
        padding: 4px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }

    .nav-page-item {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 600;
        color: #64748b;
        text-decoration: none;
        transition: all 0.15s ease;
    }

        .nav-page-item.active {
            background-color: #2563eb;
            color: #ffffff;
        }

        .nav-page-item:hover:not(.active) {
            background-color: #f1f5f9;
            color: #0f172a;
        }

    .directory-empty-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    @@keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== Mobile Adjustments ===== */
    @@media (max-width: 576px) {
        .directory-header-card {
            padding: 18px;
        }

        .btn-add-member {
            width: 100%;
            justify-content: center;
        }

        .directory-grid {
            grid-template-columns: 1fr;
        }
    }
</style>