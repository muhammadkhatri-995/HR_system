@model HR_system.ViewModels.RequestViewModel

@{
    ViewData["Title"] = "New Request";
}

<div class="request-apply-wrapper">

    <!-- Header Section -->
    <div class="form-header-card mb-4 shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon-circle">
                <i class="bi bi-file-earmark-plus-fill"></i>
            </div>
            <div>
                <h3 class="form-title mb-1">Submit New Request</h3>
                <p class="form-subtitle mb-0">Apply for time off or request an attendance correction for manager review.</p>
            </div>
        </div>
    </div>

    <!-- Main Form Container -->
    <div class="form-body-card shadow-sm">
        <form asp-action="Apply" method="post" id="requestApplyForm">

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger-custom border-0 small mb-4 rounded-3" role="alert"></div>

            <!-- Request Type Selector -->
            <div class="form-group-custom mb-4">
                <label asp-for="RequestType" class="input-label">What kind of request is this?</label>
                <div class="input-control-wrapper">
                    <i class="bi bi-layers input-icon"></i>
                    <select asp-for="RequestType" class="form-select-custom" id="requestTypeSelect" onchange="toggleFields()">
                        <option value="">-- Select Request Type --</option>
                        <option value="Leave">Leave (Vacation / Sick / Casual / Emergency)</option>
                        <option value="AttendanceCorrection">Attendance Correction (Forgot to Check In/Out)</option>
                    </select>
                </div>
                <span asp-validation-for="RequestType" class="text-danger-custom"></span>
            </div>

            <!-- SECTION 1: Leave Fields -->
            <div id="leaveFields" class="animated-field-section" style="display:none;">
                <div class="section-divider mb-3">
                    <span><i class="bi bi-calendar2-range me-1 text-primary"></i> Leave Application Details</span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="form-group-custom">
                            <label asp-for="LeaveType" class="input-label">Leave Category</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-tag input-icon"></i>
                                <select asp-for="LeaveType" class="form-select-custom">
                                    <option value="">-- Select Type --</option>
                                    <option value="Sick">Sick Leave</option>
                                    <option value="Vacation">Vacation Leave</option>
                                    <option value="Casual">Casual Leave</option>
                                    <option value="Emergency">Emergency Leave</option>
                                </select>
                            </div>
                            <span asp-validation-for="LeaveType" class="text-danger-custom"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="form-group-custom">
                            <label asp-for="StartDate" class="input-label">Start Date</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-calendar-event input-icon"></i>
                                <input asp-for="StartDate" type="date" class="form-input-custom" />
                            </div>
                            <span asp-validation-for="StartDate" class="text-danger-custom"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="form-group-custom">
                            <label asp-for="EndDate" class="input-label">End Date</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-calendar-check input-icon"></i>
                                <input asp-for="EndDate" type="date" class="form-input-custom" />
                            </div>
                            <span asp-validation-for="EndDate" class="text-danger-custom"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: Attendance Correction Fields -->
            <div id="attendanceFields" class="animated-field-section" style="display:none;">
                <div class="section-divider mb-3">
                    <span><i class="bi bi-clock-history me-1 text-primary"></i> Attendance Correction Details</span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="form-group-custom">
                            <label asp-for="AttendanceDate" class="input-label">Target Date</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-calendar3 input-icon"></i>
                                <input asp-for="AttendanceDate" type="date" class="form-input-custom" />
                            </div>
                            <span asp-validation-for="AttendanceDate" class="text-danger-custom"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="form-group-custom">
                            <label asp-for="RequestedCheckIn" class="input-label">Actual Check-In Time</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-box-arrow-in-right input-icon text-success"></i>
                                <input asp-for="RequestedCheckIn" type="time" class="form-input-custom" />
                            </div>
                            <span asp-validation-for="RequestedCheckIn" class="text-danger-custom"></span>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="form-group-custom">
                            <label asp-for="RequestedCheckOut" class="input-label">Actual Check-Out Time</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-box-arrow-right input-icon text-danger"></i>
                                <input asp-for="RequestedCheckOut" type="time" class="form-input-custom" />
                            </div>
                            <span asp-validation-for="RequestedCheckOut" class="text-danger-custom"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reason Textarea -->
            <div class="form-group-custom mt-4">
                <label asp-for="Reason" class="input-label">Reason / Justification</label>
                <textarea asp-for="Reason" class="form-textarea-custom" rows="3" placeholder="Provide a brief explanation for your request..."></textarea>
                <span asp-validation-for="Reason" class="text-danger-custom"></span>
            </div>

            <!-- Action Buttons -->
            <div class="form-actions-wrapper mt-4 pt-2">
                <button type="submit" class="btn-submit-form">
                    <i class="bi bi-send-fill me-2"></i>Submit Request
                </button>
                <a asp-action="Index" class="btn-cancel-form">Cancel</a>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleFields() {
            const type = document.getElementById('requestTypeSelect').value;
            const leaveSection = document.getElementById('leaveFields');
            const attendanceSection = document.getElementById('attendanceFields');

            if (type === 'Leave') {
                leaveSection.style.display = 'block';
                attendanceSection.style.display = 'none';
            } else if (type === 'AttendanceCorrection') {
                leaveSection.style.display = 'none';
                attendanceSection.style.display = 'block';
            } else {
                leaveSection.style.display = 'none';
                attendanceSection.style.display = 'none';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            toggleFields();
        });
    </script>
}

<style>
    /* ===== Page Fade Entrance ===== */
    .request-apply-wrapper {
        animation: pageFadeUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        max-width: 860px;
        margin: 0 auto;
    }

    /* ===== Form Header Card ===== */
    .form-header-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #e2e8f0;
    }

    .header-icon-circle {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
        border: 1px solid #dbeafe;
    }

    .form-title {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .form-subtitle {
        font-size: 13px;
        color: #64748b;
    }

    /* ===== Form Body Card ===== */
    .form-body-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 28px;
        border: 1px solid #e2e8f0;
    }

    /* ===== Input Group Styling ===== */
    .form-group-custom {
        display: flex;
        flex-direction: column;
    }

    .input-label {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .input-control-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 15px;
        transition: color 0.2s ease;
    }

    .form-input-custom,
    .form-select-custom {
        width: 100%;
        padding: 10px 14px 10px 42px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 13.5px;
        outline: none;
        transition: all 0.2s ease;
    }

        .form-input-custom:focus,
        .form-select-custom:focus {
            border-color: #2563eb;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

            .form-input-custom:focus + .input-icon,
            .input-control-wrapper:focus-within .input-icon {
                color: #2563eb;
            }

    .form-textarea-custom {
        width: 100%;
        padding: 12px 14px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 13.5px;
        outline: none;
        transition: all 0.2s ease;
        resize: vertical;
    }

        .form-textarea-custom:focus {
            border-color: #2563eb;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

    /* ===== Section Divider ===== */
    .section-divider {
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 8px;
        margin-top: 10px;
    }

        .section-divider span {
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
        }

    /* ===== Animated Field Reveal ===== */
    .animated-field-section {
        animation: slideDownFade 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* ===== Actions ===== */
    .form-actions-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-submit-form {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 8px;
        border: 1px solid #1d4ed8;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        transition: all 0.25s ease;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

        .btn-submit-form:hover {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        }

    .btn-cancel-form {
        background: #ffffff;
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .btn-cancel-form:hover {
            background: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

    .text-danger-custom {
        font-size: 11.5px;
        color: #dc2626;
        margin-top: 4px;
        display: block;
    }

    .alert-danger-custom {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* ===== Animations ===== */
    @@keyframes pageFadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideDownFade {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== Responsive ===== */
    @@media (max-width: 576px) {
        .form-header-card, .form-body-card {
            padding: 20px;
        }

        .form-actions-wrapper {
            flex-direction: column;
            width: 100%;
        }

        .btn-submit-form, .btn-cancel-form {
            width: 100%;
            justify-content: center;
            text-align: center;
        }
    }
</style>