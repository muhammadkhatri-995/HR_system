@model HR_system.ViewModels.RequestViewModel

@{
    ViewData["Title"] = "New Request";
}

<h2>New Request</h2>

<div class="employee-form-container">
    <form asp-action="Apply" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group form-group-full mb-3">
            <label asp-for="RequestType" class="form-label">What kind of request is this?</label>
            <select asp-for="RequestType" class="form-control" id="requestTypeSelect" onchange="toggleFields()">
                <option value="">-- Select Request Type --</option>
                <option value="Leave">Leave (Vacation / Sick / Casual)</option>
                <option value="AttendanceCorrection">Attendance Correction (forgot to check in/out)</option>
            </select>
            <span asp-validation-for="RequestType" class="text-danger"></span>
        </div>

        <div id="leaveFields" style="display:none;">
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="LeaveType" class="form-label">Leave Type</label>
                    <select asp-for="LeaveType" class="form-control">
                        <option value="">-- Select --</option>
                        <option value="Sick">Sick</option>
                        <option value="Vacation">Vacation</option>
                        <option value="Casual">Casual</option>
                        <option value="Emergency">Emergency</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" class="form-control" />
                </div>
            </div>
        </div>

        <div id="attendanceFields" style="display:none;">
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="AttendanceDate" class="form-label">Date</label>
                    <input asp-for="AttendanceDate" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="RequestedCheckIn" class="form-label">Actual Check-In Time</label>
                    <input asp-for="RequestedCheckIn" type="time" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="RequestedCheckOut" class="form-label">Actual Check-Out Time</label>
                    <input asp-for="RequestedCheckOut" type="time" class="form-control" />
                </div>
            </div>
        </div>

        <div class="form-group form-group-full mt-3">
            <label asp-for="Reason" class="form-label">Reason</label>
            <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>

        <div class="mt-3" style="text-align:center;">
            <button type="submit" class="btn-add-employee">Submit Request</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function toggleFields() {
            const type = document.getElementById('requestTypeSelect').value;
            document.getElementById('leaveFields').style.display = (type === 'Leave') ? 'block' : 'none';
            document.getElementById('attendanceFields').style.display = (type === 'AttendanceCorrection') ? 'block' : 'none';
        }
        toggleFields();
    </script>
}