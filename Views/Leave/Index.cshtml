@using HR_system.Models

@{
    ViewData["Title"] = "Requests";
    bool isManager = ViewBag.IsManager;
    var leaves = (IEnumerable<Leave>)ViewBag.Leaves;
    var attendanceRequests = (IEnumerable<AttendanceRequest>)ViewBag.AttendanceRequests;
}

<div class="requests-page-wrapper">

    <!-- Header & Action Panel -->
    <div class="requests-header-panel mb-4 shadow-sm">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h3 class="page-title mb-1">
                    <i class="bi bi-file-earmark-check me-2 text-primary"></i>
                    @(isManager ? "Workforce Requests Portal" : "My Submitted Requests")
                </h3>
                <p class="page-subtitle mb-0">
                    @(isManager ? "Review, approve, or reject employee leave and attendance correction applications." : "Track your leave balances and correction request progress in real-time.")
                </p>
            </div>

            <a asp-action="Apply" class="btn-create-request">
                <i class="bi bi-plus-circle-fill me-2"></i>New Request
            </a>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger-custom mt-3 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            </div>
        }
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs custom-nav-tabs border-0 mb-4" id="requestsTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="leaves-tab" data-bs-toggle="tab" data-bs-target="#leaves-pane" type="button" role="tab">
                <i class="bi bi-calendar2-range me-2"></i>Leave Requests
                <span class="tab-badge">@leaves.Count()</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="attendance-tab" data-bs-toggle="tab" data-bs-target="#attendance-pane" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i>Attendance Corrections
                <span class="tab-badge">@attendanceRequests.Count()</span>
            </button>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="tab-content" id="requestsTabContent">

        <!-- SECTION 1: Leave Requests -->
        <div class="tab-pane fade show active" id="leaves-pane" role="tabpanel">
            <div class="requests-card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle custom-table mb-0">
                        <thead>
                            <tr>
                                @if (isManager)
                                {
                                    <th class="ps-3">Employee</th>
                                }
                                <th>Type</th>
                                <th>Schedule / Dates</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!leaves.Any())
                            {
                                <tr>
                                    <td colspan="@(isManager ? 6 : 5)" class="empty-table-state">
                                        <i class="bi bi-inbox fs-2 text-muted opacity-50 d-block mb-1"></i>
                                        <span>No leave requests found in system.</span>
                                    </td>
                                </tr>
                            }
                            @foreach (var item in leaves)
                            {
                                <tr class="request-row-item">
                                    @if (isManager)
                                    {
                                        <td class="ps-3 fw-bold text-dark">
                                            <i class="bi bi-person-circle me-1.5 text-primary"></i>
                                            @(item.Employee != null ? $"{item.Employee.FirstName} {item.Employee.LastName}" : "Unknown")
                                        </td>
                                    }
                                    <td>
                                        <span class="leave-type-pill">@item.LeaveType</span>
                                    </td>
                                    <td>
                                        <div class="date-range-box">
                                            <i class="bi bi-calendar-event me-1 text-muted"></i>
                                            <span>@item.StartDate.ToShortDateString()</span>
                                            <i class="bi bi-arrow-right mx-1 text-muted small"></i>
                                            <span>@item.EndDate.ToShortDateString()</span>
                                        </div>
                                    </td>
                                    <td class="reason-cell">
                                        <span class="text-truncate d-inline-block" style="max-width: 220px;" title="@item.Reason">
                                            @item.Reason
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-pill @(item.Status == "Approved" ? "pill-approved" : item.Status == "Rejected" ? "pill-rejected" : "pill-pending")">
                                            <span class="status-dot"></span> @item.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (isManager && item.Status == "Pending")
                                        {
                                            <div class="d-inline-flex gap-1.5">
                                                <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn-action-sm btn-approve" title="Approve Request">
                                                        <i class="bi bi-check-lg me-1"></i>Approve
                                                    </button>
                                                </form>
                                                <form asp-action="Reject" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn-action-sm btn-reject" title="Reject Request">
                                                        <i class="bi bi-x-lg me-1"></i>Reject
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fs-7">Completed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- SECTION 2: Attendance Corrections -->
        <div class="tab-pane fade" id="attendance-pane" role="tabpanel">
            <div class="requests-card shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle custom-table mb-0">
                        <thead>
                            <tr>
                                @if (isManager)
                                {
                                    <th class="ps-3">Employee</th>
                                }
                                <th>Date</th>
                                <th>Requested Check In</th>
                                <th>Requested Check Out</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!attendanceRequests.Any())
                            {
                                <tr>
                                    <td colspan="@(isManager ? 7 : 6)" class="empty-table-state">
                                        <i class="bi bi-clock-history fs-2 text-muted opacity-50 d-block mb-1"></i>
                                        <span>No attendance correction requests submitted.</span>
                                    </td>
                                </tr>
                            }
                            @foreach (var item in attendanceRequests)
                            {
                                <tr class="request-row-item">
                                    @if (isManager)
                                    {
                                        <td class="ps-3 fw-bold text-dark">
                                            <i class="bi bi-person-circle me-1.5 text-primary"></i>
                                            @(item.Employee != null ? $"{item.Employee.FirstName} {item.Employee.LastName}" : "Unknown")
                                        </td>
                                    }
                                    <td class="fw-semibold">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>@item.Date.ToShortDateString()
                                    </td>
                                    <td>
                                        <span class="time-badge"><i class="bi bi-box-arrow-in-right text-success me-1"></i>@(item.RequestedCheckIn?.ToString(@"hh\:mm") ?? "-")</span>
                                    </td>
                                    <td>
                                        <span class="time-badge"><i class="bi bi-box-arrow-right text-danger me-1"></i>@(item.RequestedCheckOut?.ToString(@"hh\:mm") ?? "-")</span>
                                    </td>
                                    <td class="reason-cell">
                                        <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@item.Reason">
                                            @item.Reason
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-pill @(item.Status == "Approved" ? "pill-approved" : item.Status == "Rejected" ? "pill-rejected" : "pill-pending")">
                                            <span class="status-dot"></span> @item.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (isManager && item.Status == "Pending")
                                        {
                                            <div class="d-inline-flex gap-1.5">
                                                <form asp-action="ApproveAttendanceRequest" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn-action-sm btn-approve" title="Approve Request">
                                                        <i class="bi bi-check-lg me-1"></i>Approve
                                                    </button>
                                                </form>
                                                <form asp-action="RejectAttendanceRequest" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn-action-sm btn-reject" title="Reject Request">
                                                        <i class="bi bi-x-lg me-1"></i>Reject
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fs-7">Completed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    /* ===== Main Container Animation ===== */
    .requests-page-wrapper {
        animation: pageFadeUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* ===== Top Header Card ===== */
    .requests-header-panel {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #e2e8f0;
    }

    .page-title {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .page-subtitle {
        font-size: 13px;
        color: #64748b;
    }

    .btn-create-request {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #ffffff;
        font-weight: 600;
        font-size: 13.5px;
        padding: 10px 20px;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.25s ease;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

        .btn-create-request:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
        }

    /* ===== Custom Navigation Tabs ===== */
    .custom-nav-tabs .nav-link {
        color: #64748b;
        font-weight: 600;
        font-size: 13.5px;
        padding: 10px 18px;
        border-radius: 10px;
        border: 1px solid transparent;
        transition: all 0.2s ease;
        background: rgba(241, 245, 249, 0.6);
        margin-right: 8px;
    }

        .custom-nav-tabs .nav-link:hover {
            color: #0f172a;
            background: #f1f5f9;
        }

        .custom-nav-tabs .nav-link.active {
            color: #2563eb;
            background: #ffffff;
            border-color: #cbd5e1;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

    .tab-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        background: #e2e8f0;
        color: #334155;
        margin-left: 6px;
    }

    .custom-nav-tabs .nav-link.active .tab-badge {
        background: #dbeafe;
        color: #1e40af;
    }

    /* ===== Requests Card & Table ===== */
    .requests-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    .custom-table thead {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .custom-table th {
        font-size: 12px;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        padding: 14px 16px;
    }

    .request-row-item {
        transition: background-color 0.15s ease;
    }

        .request-row-item:hover {
            background-color: #f8fafc;
        }

    .custom-table td {
        padding: 14px 16px;
        font-size: 13.5px;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
    }

    /* ===== Custom Badges & Tags ===== */
    .leave-type-pill {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        font-weight: 600;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid #dbeafe;
    }

    .date-range-box {
        font-size: 12.5px;
        color: #475569;
        background: #f8fafc;
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        border: 1px solid #f1f5f9;
    }

    .time-badge {
        font-size: 12.5px;
        font-weight: 600;
        color: #0f172a;
    }

    /* ===== Status Pills ===== */
    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .pill-approved {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .pill-rejected {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .pill-pending {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fef3c7;
    }

    /* ===== Action Buttons ===== */
    .btn-action-sm {
        border: none;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
    }

    .btn-approve {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

        .btn-approve:hover {
            background: #16a34a;
            color: #ffffff;
            border-color: #16a34a;
        }

    .btn-reject {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

        .btn-reject:hover {
            background: #dc2626;
            color: #ffffff;
            border-color: #dc2626;
        }

    .empty-table-state {
        text-align: center;
        padding: 40px 16px !important;
        color: #64748b;
    }

    .alert-danger-custom {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 13px;
    }

    @@keyframes pageFadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== Responsive Adjustments ===== */
    @@media (max-width: 576px) {
        .requests-header-panel {
            padding: 18px;
        }

        .btn-create-request {
            width: 100%;
            justify-content: center;
        }

        .custom-nav-tabs .nav-link {
            width: 100%;
            margin-bottom: 6px;
        }
    }
</style>