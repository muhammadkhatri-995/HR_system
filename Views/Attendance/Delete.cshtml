@model HR_system.Models.Attendence  

@{
    ViewData["Title"] = "Delete Attendance";
}

<h2>Delete Attendance Record</h2>

<div class="employee-form-container">
    <p>Are you sure you want to delete this attendance record?</p>

    <dl class="row">
        <dt class="col-sm-3">Employee</dt>
        <dd class="col-sm-9">@(Model.Employee != null ? $"{Model.Employee.FirstName} {Model.Employee.LastName}" : "Unknown")</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>