@model HR_system.ViewModels.AttendanceViewModel

@{
    ViewData["Title"] = "Mark Attendance";
}

<style>
    /* Animated Header Wrapper */
    .attendance-header-wrapper {
        animation: fadeInDownHeader 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Icon Badge Accent */
    .header-icon-badge {
        width: 46px;
        height: 46px;
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        box-shadow: 0 8px 16px -4px rgba(13, 110, 253, 0.35);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .attendance-header-wrapper:hover .header-icon-badge {
        transform: scale(1.08) rotate(-4deg);
        box-shadow: 0 12px 20px -4px rgba(13, 110, 253, 0.45);
    }

    /* Gradient Bottom Border Line */
    .header-accent-line {
        height: 3px;
        width: 60px;
        background: linear-gradient(90deg, #0d6efd, transparent);
        border-radius: 2px;
    }

    /* Keyframe Entrance Animation */
    @@keyframes fadeInDownHeader {
        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- Modern Animated Heading -->
<div class="attendance-header-wrapper d-flex align-items-center gap-3 pb-3 mb-4 border-bottom">
    <div class="header-icon-badge rounded-3 text-white d-flex align-items-center justify-content-center flex-shrink-0">
        <i class="bi bi-calendar-check fs-4"></i>
    </div>
    <div>
        <h2 class="fw-bold text-dark mb-0 fs-3">Mark Attendance</h2>
        <p class="text-muted small mb-0 mt-1">Record employee daily check-in, check-out, and attendance status</p>
        <div class="header-accent-line mt-2"></div>
    </div>
</div>

<div class="employee-form-container">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="EmployeeId" class="form-label">Employee</label>
                <select asp-for="EmployeeId" asp-items="Model.Employees" class="form-control">
                    <option value="">-- Select Employee --</option>
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-control">
                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>
                    <option value="Late">Late</option>
                    <option value="Leave">Leave</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="CheckIn" class="form-label"></label>
                <input asp-for="CheckIn" type="time" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="CheckOut" class="form-label"></label>
                <input asp-for="CheckOut" type="time" class="form-control" />
            </div>
        </div>

        <div class="mt-3" style="text-align:center;">
            <button type="submit" class="btn-add-employee">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>