@model HR_system.Models.Role

@{
    ViewData["Title"] = "Add Role";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Back Link -->
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Roles
                </a>
            </div>

            <!-- Card Container -->
            <div class="card border-0 shadow-sm rounded-3">

                <!-- Card Header -->
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex align-items-center">
                        <div class="avatar-sm rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px; background-color: #e0e7ff; color: #4338ca;">
                            <i class="bi bi-shield-plus fs-5"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-0">Add Role</h4>
                            <p class="text-muted small mb-0">Define a new authorization role and its scope.</p>
                        </div>
                    </div>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" novalidate>

                        <!-- Model Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small mb-4" role="alert"></div>

                        <!-- Role Name (Floating Label) -->
                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" id="roleName" placeholder="e.g. Administrator" />
                            <label asp-for="Name" for="roleName">Role Name <span class="text-danger">*</span></label>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Role Description (Floating Label) -->
                        <div class="form-floating mb-4">
                            <textarea asp-for="Description" class="form-control" id="roleDescription" placeholder="Description" style="height: 120px;"></textarea>
                            <label asp-for="Description" for="roleDescription">Role Description</label>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-2">
                                Cancel
                            </a>
                            <button type="submit" class="btn text-white px-4 rounded-2 shadow-sm" style="background-color: #4f46e5; border-color: #4f46e5;">
                                <i class="bi bi-check-lg me-1"></i> Save Role
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}