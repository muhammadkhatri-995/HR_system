@model HR_system.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<style>
    /* Gradient Background & Pattern */
    .login-wrapper {
        min-height: 85vh;
        background: radial-gradient(circle at top right, rgba(13, 110, 253, 0.08), transparent 40%), radial-gradient(circle at bottom left, rgba(13, 110, 253, 0.05), transparent 40%);
    }

    /* Card Entrance Animation & Styling */
    .login-card {
        border: 1px solid rgba(255, 255, 255, 0.6) !important;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        transform: translateY(0);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        animation: slideUpFade 0.7s ease-out forwards;
    }

        .login-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px -15px rgba(13, 110, 253, 0.15) !important;
        }

    /* Header Styling & Icon Pulse */
    .avatar-icon {
        background: linear-gradient(135deg, #0d6efd, #0a58ca);
        box-shadow: 0 8px 16px -4px rgba(13, 110, 253, 0.4);
        transition: transform 0.3s ease;
    }

    .login-card:hover .avatar-icon {
        transform: scale(1.08) rotate(-3deg);
    }

    /* Animated Form Inputs */
    .form-floating .form-control {
        border-color: #e2e8f0;
        transition: all 0.25s ease;
    }

        .form-floating .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
        }

    /* Interactive Button Styling */
    .btn-login {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
        border: none;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-login:hover {
            background: linear-gradient(135deg, #0b5ed7, #0a58ca);
            transform: translateY(-1px);
            box-shadow: 0 8px 20px -4px rgba(13, 110, 253, 0.4) !important;
        }

        .btn-login:active {
            transform: translateY(0);
        }

    /* Entrance Keyframes */
    @keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container login-wrapper d-flex align-items-center justify-content-center py-5">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-sm-9 col-md-7 col-lg-5 col-xl-4">

            <!-- Login Card -->
            <div class="card login-card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header Banner -->
                <div class="card-header border-0 bg-transparent text-center pt-4 pb-2 px-4">
                    <div class="avatar-md avatar-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 58px; height: 58px;">
                        <i class="bi bi-person-lock fs-3"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Kinetic HR</h4>
                    <p class="text-muted small mb-0">Sign in to manage your workspace</p>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4 pt-3">
                    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" asp-antiforgery="false" novalidate>

                        <!-- Validation Summary Alert -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small mb-4 rounded-3" role="alert"></div>

                        <!-- Email Address -->
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control rounded-3" id="loginEmail" placeholder="name@example.com" autocomplete="username" />
                            <label asp-for="Email" for="loginEmail">
                                <i class="bi bi-envelope me-1 text-muted"></i> Email Address
                            </label>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Password -->
                        <div class="position-relative mb-2">
                            <div class="form-floating">
                                <input asp-for="Password" type="password" class="form-control rounded-3" id="loginPassword" placeholder="Password" autocomplete="current-password" />
                                <label asp-for="Password" for="loginPassword">
                                    <i class="bi bi-key me-1 text-muted"></i> Password
                                </label>
                            </div>
                            <button type="button" class="btn border-0 text-muted position-absolute end-0 top-50 translate-middle-y me-2" id="togglePasswordBtn" style="z-index: 5;" tabindex="-1">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block mb-3"></span>

                        <!-- Remember Me -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted small user-select-none" for="rememberMe">
                                    Remember me
                                </label>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary btn-login btn-lg w-100 rounded-3 shadow-sm py-2.5 fw-semibold fs-6">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light bg-opacity-50 border-0 text-center py-3">
                    <p class="text-muted fs-7 mb-0 small">
                        <i class="bi bi-shield-check text-success me-1"></i> Secure Enterprise System
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('togglePasswordBtn')?.addEventListener('click', function () {
            const passwordInput = document.getElementById('loginPassword');
            const icon = document.getElementById('togglePasswordIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        });
    </script>
}