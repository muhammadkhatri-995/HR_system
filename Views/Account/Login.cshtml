@model HR_system.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 75vh;">
        <div class="col-12 col-sm-8 col-md-6 col-lg-4">
            
            <!-- Login Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                
                <!-- Header Banner -->
                <div class="card-header border-0 bg-primary bg-gradient text-white text-center py-4 px-3">
                    <div class="avatar-md bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm mb-2" style="width: 54px; height: 54px;">
                        <i class="bi bi-person-lock fs-3"></i>
                    </div>
                    <h4 class="fw-bold mb-0">Kinetic HR</</h4>
                    <p class="text-white-50 small mb-0">Sign in to manage your workspace</p>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4">
                    <form asp-action="Login" method="post" novalidate>
                        
                        <!-- Validation Summary Alert -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small mb-4" role="alert"></div>

                        <!-- Email Address (Floating Label) -->
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" id="loginEmail" placeholder="name@example.com" autocomplete="username" />
                            <label asp-for="Email" for="loginEmail">
                                <i class="bi bi-envelope me-1 text-muted"></i> Email Address
                            </label>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Password (Floating Label with Toggle) -->
                        <div class="position-relative mb-3">
                            <div class="form-floating">
                                <input asp-for="Password" type="password" class="form-control" id="loginPassword" placeholder="Password" autocomplete="current-password" />
                                <label asp-for="Password" for="loginPassword">
                                    <i class="bi bi-key me-1 text-muted"></i> Password
                                </label>
                            </div>
                            <button type="button" class="btn border-0 text-muted position-absolute end-0 top-50 translate-middle-y me-2" id="togglePasswordBtn" style="z-index: 5;">
                                <i class="bi bi-eye" id="togglePasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block mb-3"></span>

                        <!-- Remember Me / Extra Links (Optional Layout Slot) -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted small" for="rememberMe">
                                    Remember me
                                </label>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 shadow-sm py-2 fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light border-0 text-center py-3">
                    <p class="text-muted fs-7 mb-0">
                        <i class="bi bi-shield-check text-success me-1"></i> Secure Enterprise System
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Password Visibility Toggle Script
        document.getElementById('togglePasswordBtn')?.addEventListener('click', function () {
            const passwordInput = document.getElementById('loginPassword');
            const icon = document.getElementById('togglePasswordIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });
    </script>
}