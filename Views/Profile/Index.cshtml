@model HR_system.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page-wrapper">

    <!-- Ambient Floating Light Orbs -->
    <div class="profile-orb orb-1"></div>
    <div class="profile-orb orb-2"></div>

    <div class="container py-4 position-relative">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-7 col-xl-6">

                <!-- Alert Message -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success-custom mb-4 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    </div>
                }

                <!-- Main Glassmorphic Profile Card -->
                <div class="profile-card shadow-sm">

                    <!-- Cover Header Gradient Banner -->
                    <div class="profile-cover-banner">
                        <span class="system-tag-badge">
                            <i class="bi bi-shield-check me-1"></i> Verified Employee
                        </span>
                    </div>

                    <!-- Avatar & Essential Identity -->
                    <div class="profile-header-body text-center">
                        <div class="profile-avatar-wrapper shadow">
                            @if (!string.IsNullOrEmpty(Model.ExistingPhotoPath))
                            {
                                <img src="@Model.ExistingPhotoPath" alt="@Model.FirstName @Model.LastName" class="avatar-image" />
                            }
                            else
                            {
                                <div class="avatar-fallback-initial">
                                    @(!string.IsNullOrWhiteSpace(Model.FirstName) ? Model.FirstName.Substring(0, 1).ToUpper() : "U")
                                </div>
                            }
                        </div>

                        <h3 class="user-full-name mb-1">@Model.FirstName @Model.LastName</h3>

                        <div class="user-role-dept-meta mb-3">
                            <span class="meta-badge badge-role">
                                <i class="bi bi-briefcase me-1"></i>@(Model.RoleName ?? "Employee")
                            </span>
                            <span class="meta-badge badge-dept">
                                <i class="bi bi-building me-1"></i>@(Model.DepartmentName ?? "Unassigned")
                            </span>
                        </div>
                    </div>

                    <!-- Information Details Grid -->
                    <div class="profile-details-section mx-3 mb-4">
                        <div class="detail-card-row">
                            <div class="detail-icon-box icon-email">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <div class="detail-content">
                                <span class="detail-label">Email Address</span>
                                <span class="detail-value text-truncate">@Model.Email</span>
                            </div>
                        </div>

                        <div class="detail-card-row">
                            <div class="detail-icon-box icon-phone">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div class="detail-content">
                                <span class="detail-label">Phone Number</span>
                                <span class="detail-value">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</span>
                            </div>
                        </div>

                        <div class="detail-card-row">
                            <div class="detail-icon-box icon-address">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div class="detail-content">
                                <span class="detail-label">Office / Residential Address</span>
                                <span class="detail-value">@(string.IsNullOrEmpty(Model.Address) ? "No address specified" : Model.Address)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons Footer -->
                    <div class="profile-actions-footer">
                        <a asp-action="Edit" class="btn-profile-action btn-edit-profile">
                            <i class="bi bi-pencil-square me-1.5"></i>Edit Profile
                        </a>
                        <a asp-action="ChangePassword" class="btn-profile-action btn-change-pass">
                            <i class="bi bi-key-fill me-1.5"></i>Change Password
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>

<style>
    /* ===== Canvas Architecture & Entrance ===== */
    .profile-page-wrapper {
        position: relative;
        animation: pageFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        overflow: hidden;
        min-height: 80vh;
    }

    /* ===== Background Floating Glow Orbs ===== */
    .profile-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.35;
        z-index: 0;
    }

    .orb-1 {
        width: 320px;
        height: 320px;
        background: #3b82f6;
        top: -60px;
        left: -60px;
    }

    .orb-2 {
        width: 340px;
        height: 340px;
        background: #8b5cf6;
        bottom: -60px;
        right: -60px;
    }

    /* ===== Glassmorphism Profile Card ===== */
    .profile-card {
        background: #ffffff;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        position: relative;
        z-index: 1;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .profile-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.08) !important;
        }

    /* ===== Cover Banner ===== */
    .profile-cover-banner {
        height: 120px;
        background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 50%, #2563eb 100%);
        position: relative;
        padding: 16px;
        display: flex;
        justify-content: flex-end;
        align-items: flex-start;
    }

    .system-tag-badge {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-size: 11.5px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* ===== Avatar Section ===== */
    .profile-header-body {
        position: relative;
        margin-top: -55px;
        padding: 0 24px 16px 24px;
    }

    .profile-avatar-wrapper {
        width: 106px;
        height: 106px;
        border-radius: 50%;
        margin: 0 auto 14px auto;
        padding: 4px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
    }

    .avatar-image {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .avatar-fallback-initial {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);
        color: #ffffff;
        font-size: 42px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .user-full-name {
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .user-role-dept-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .meta-badge {
        font-size: 12px;
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 6px;
    }

    .badge-role {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #dbeafe;
    }

    .badge-dept {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    /* ===== Information Details Rows ===== */
    .profile-details-section {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .detail-card-row {
        background: #f8fafc;
        border-radius: 12px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        border: 1px solid #f1f5f9;
        transition: background-color 0.2s ease;
    }

        .detail-card-row:hover {
            background: #f1f5f9;
        }

    .detail-icon-box {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }

    .icon-email {
        background: #eff6ff;
        color: #3b82f6;
    }

    .icon-phone {
        background: #ecfdf5;
        color: #10b981;
    }

    .icon-address {
        background: #fffbeb;
        color: #f59e0b;
    }

    .detail-content {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .detail-label {
        font-size: 11.5px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .detail-value {
        font-size: 14px;
        font-weight: 600;
        color: #1e293b;
    }

    /* ===== Footer Actions ===== */
    .profile-actions-footer {
        padding: 16px 24px 24px 24px;
        display: flex;
        gap: 12px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-profile-action {
        flex: 1;
        text-align: center;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
    }

    .btn-edit-profile {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #ffffff;
        border: 1px solid #1d4ed8;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

        .btn-edit-profile:hover {
            color: #ffffff;
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        }

    .btn-change-pass {
        background: #ffffff;
        color: #334155;
        border: 1px solid #cbd5e1;
    }

        .btn-change-pass:hover {
            background: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

    .alert-success-custom {
        background: #ecfdf5;
        color: #065f46;
        border: 1px solid #a7f3d0;
        border-radius: 12px;
        padding: 12px 18px;
        font-size: 13.5px;
        font-weight: 600;
    }

    /* ===== Keyframes ===== */
    @@keyframes pageFadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== Mobile Adjustments ===== */
    @@media (max-width: 576px) {
        .profile-actions-footer {
            flex-direction: column;
        }

        .btn-profile-action {
            width: 100%;
        }

        .user-full-name {
            font-size: 20px;
        }
    }
</style>