@model HR_system.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="employee-form-container" style="text-align:center; max-width:500px;">
    <div class="employee-photo-wrapper" style="margin:0 auto 15px auto;">
        @if (!string.IsNullOrEmpty(Model.ExistingPhotoPath))
        {
            <img src="@Model.ExistingPhotoPath" alt="@Model.FirstName" />
        }
        else
        {
            <span class="employee-photo-placeholder">@Model.FirstName.Substring(0, 1)</span>
        }
    </div>

    <h3>@Model.FirstName @Model.LastName</h3>
    <p style="color:#6b7280;">@Model.RoleName · @Model.DepartmentName</p>

    <dl class="row mt-3" style="text-align:left;">
        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Phone</dt>
        <dd class="col-sm-8">@Model.Phone</dd>

        <dt class="col-sm-4">Address</dt>
        <dd class="col-sm-8">@(Model.Address ?? "-")</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" class="btn-add-employee">Edit Profile</a>
        <a asp-action="ChangePassword" class="btn btn-secondary">Change Password</a>
    </div>
</div>