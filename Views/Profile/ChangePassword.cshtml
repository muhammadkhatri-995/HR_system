@model HR_system.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="change-pass-wrapper">

    <!-- Ambient Floating Orbs -->
    <div class="pass-orb orb-1"></div>
    <div class="pass-orb orb-2"></div>

    <div class="container py-4 position-relative">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5">

                <!-- Header Card -->
                <div class="pass-header-card mb-4 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="header-icon-box">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <h3 class="card-title-custom mb-1">Change Password</h3>
                            <p class="card-subtitle-custom mb-0">Update your account credentials to keep your portal secure.</p>
                        </div>
                    </div>
                </div>

                <!-- Main Form Body Card -->
                <div class="pass-body-card shadow-sm">
                    <form asp-action="ChangePassword" method="post" id="changePasswordForm">

                        <!-- Validation Summary Alert -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger-custom border-0 small mb-4 rounded-3" role="alert"></div>

                        <!-- Current Password -->
                        <div class="form-group-custom mb-3.5">
                            <label asp-for="CurrentPassword" class="input-label">Current Password</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-key input-lead-icon"></i>
                                <input asp-for="CurrentPassword" type="password" class="form-input-custom" id="currentPasswordInput" placeholder="Enter current password" autocomplete="current-password" />
                                <button type="button" class="btn-pass-toggle" onclick="togglePassVisibility('currentPasswordInput', 'currentPassIcon')" tabindex="-1">
                                    <i class="bi bi-eye" id="currentPassIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger-custom"></span>
                        </div>

                        <!-- New Password -->
                        <div class="form-group-custom mb-3.5">
                            <label asp-for="NewPassword" class="input-label">New Password</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-lock input-lead-icon"></i>
                                <input asp-for="NewPassword" type="password" class="form-input-custom" id="newPasswordInput" placeholder="Enter new password" autocomplete="new-password" />
                                <button type="button" class="btn-pass-toggle" onclick="togglePassVisibility('newPasswordInput', 'newPassIcon')" tabindex="-1">
                                    <i class="bi bi-eye" id="newPassIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger-custom"></span>
                        </div>

                        <!-- Confirm New Password -->
                        <div class="form-group-custom mb-4">
                            <label asp-for="ConfirmNewPassword" class="input-label">Confirm New Password</label>
                            <div class="input-control-wrapper">
                                <i class="bi bi-check2-circle input-lead-icon"></i>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-input-custom" id="confirmPasswordInput" placeholder="Re-enter new password" autocomplete="new-password" />
                                <button type="button" class="btn-pass-toggle" onclick="togglePassVisibility('confirmPasswordInput', 'confirmPassIcon')" tabindex="-1">
                                    <i class="bi bi-eye" id="confirmPassIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger-custom"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="form-actions-wrapper pt-2">
                            <button type="submit" class="btn-submit-pass shadow-sm">
                                <i class="bi bi-arrow-repeat me-1.5"></i>Update Password
                            </button>
                            <a asp-action="Index" class="btn-cancel-pass">Cancel</a>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function togglePassVisibility(inputId, iconId) {
            const passInput = document.getElementById(inputId);
            const passIcon = document.getElementById(iconId);

            if (passInput && passIcon) {
                if (passInput.type === 'password') {
                    passInput.type = 'text';
                    passIcon.classList.replace('bi-eye', 'bi-eye-slash');
                } else {
                    passInput.type = 'password';
                    passIcon.classList.replace('bi-eye-slash', 'bi-eye');
                }
            }
        }
    </script>
}

<style>
    /* ===== Canvas Architecture & Entrance ===== */
    .change-pass-wrapper {
        position: relative;
        animation: pageFadeUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        overflow: hidden;
        min-height: 80vh;
    }

    /* ===== Background Floating Glow Orbs ===== */
    .pass-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.35;
        z-index: 0;
    }

    .orb-1 {
        width: 300px;
        height: 300px;
        background: #3b82f6;
        top: -50px;
        right: -50px;
    }

    .orb-2 {
        width: 320px;
        height: 320px;
        background: #8b5cf6;
        bottom: -50px;
        left: -50px;
    }

    /* ===== Header Card ===== */
    .pass-header-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #e2e8f0;
        position: relative;
        z-index: 1;
    }

    .header-icon-box {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
        border: 1px solid #dbeafe;
    }

    .card-title-custom {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .card-subtitle-custom {
        font-size: 13px;
        color: #64748b;
    }

    /* ===== Main Body Card ===== */
    .pass-body-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 28px;
        border: 1px solid #e2e8f0;
        position: relative;
        z-index: 1;
    }

    /* ===== Inputs Styling ===== */
    .form-group-custom {
        display: flex;
        flex-direction: column;
    }

    .input-label {
        font-size: 12.5px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }

    .input-control-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-lead-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 15px;
        transition: color 0.2s ease;
    }

    .form-input-custom {
        width: 100%;
        padding: 10px 42px 10px 40px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 13.5px;
        outline: none;
        transition: all 0.2s ease;
    }

        .form-input-custom:focus {
            border-color: #2563eb;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

            .form-input-custom:focus + .input-lead-icon,
            .input-control-wrapper:focus-within .input-lead-icon {
                color: #2563eb;
            }

    .btn-pass-toggle {
        position: absolute;
        right: 12px;
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 15px;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .btn-pass-toggle:hover {
            color: #475569;
        }

    /* ===== Actions Buttons ===== */
    .form-actions-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-submit-pass {
        flex: 1;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid #1d4ed8;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
    }

        .btn-submit-pass:hover {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        }

    .btn-cancel-pass {
        background: #ffffff;
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        text-decoration: none;
        transition: all 0.2s ease;
        text-align: center;
    }

        .btn-cancel-pass:hover {
            background: #f8fafc;
            color: #0f172a;
            border-color: #94a3b8;
        }

    .text-danger-custom {
        font-size: 11.5px;
        color: #dc2626;
        margin-top: 4px;
        display: block;
    }

    .alert-danger-custom {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    /* ===== Keyframes ===== */
    @@keyframes pageFadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== Mobile Adjustments ===== */
    @@media (max-width: 576px) {
        .pass-header-card, .pass-body-card {
            padding: 20px;
        }

        .form-actions-wrapper {
            flex-direction: column;
            width: 100%;
        }

        .btn-submit-pass, .btn-cancel-pass {
            width: 100%;
        }
    }
</style>